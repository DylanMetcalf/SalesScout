# Sales Scout configuration. Copy to .env.local (local) or set in your host's dashboard.
# Everything is optional for a personal local install.

# Server-wide Anthropic API key, used for every account that hasn't pasted its own
# key in Settings → AI & research. Leave empty if you'd rather paste it in the app.
ANTHROPIC_API_KEY=

# Encrypts API keys pasted into Settings. If unset, a key is generated once and
# kept in data/.secret-key. On a hosted server, set this and never change it.
# APP_ENCRYPTION_KEY=

# Administrator login email(s), comma-separated: use the server key without limits and
# open /admin. If unset, the first account created is the administrator.
# ADMIN_EMAILS=you@example.com

# Set to false to close sign-ups (recommended on a hosted instance once your account exists).
# ALLOW_SIGNUPS=true

# Override the model used by the AI orchestrator.
# SALES_SCOUT_MODEL=claude-opus-5-5
# Route one step to another model to trial it (compare cost and quality in Admin → Operations first):
# SALES_SCOUT_MODEL_OUTREACH=  SALES_SCOUT_MODEL_QUALIFICATION=  (any agent name, upper-cased)

# Where the database (and uploaded documents, next to it) live. Default: ./data/salesscout.db
# DATABASE_PATH=./data/salesscout.db

# Discovery-call booking page shown on /contact (Calendly, Cal.com, Google Calendar
# appointment schedule). The scheduling tool adds the Zoom / Google Meet link.
# BOOKING_URL=https://calendly.com/you/discovery-call

# Email each website enquiry via Resend (https://resend.com). Without a verified
# domain, sign up to Resend with the address that should receive the emails.
# RESEND_API_KEY=
# ENQUIRY_EMAIL=salesscout@meacreo.co.za
# RESEND_FROM=Sales Scout <onboarding@resend.dev>

# Public address for links and the sitemap (default https://www.salesscout.co.za).
# SITE_URL=https://www.salesscout.co.za

# --- Billing: Paystack (hosted checkout, recurring plans, signed webhooks) ---
# Webhook URL to set in Paystack: https://www.salesscout.co.za/api/billing/paystack
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PLAN_SCOUT=PLN_...      PLAN_PRICE_ZAR_SCOUT=...   (display price; must match the Paystack plan)
# PAYSTACK_PLAN_GROWTH=PLN_...     PLAN_PRICE_ZAR_GROWTH=...
# PAYSTACK_PLAN_SCALE=PLN_...      PLAN_PRICE_ZAR_SCALE=...

# --- Free-account protection: require verification before the 5 free unlocks ---
# REQUIRE_EMAIL_VERIFICATION=true   (needs RESEND_API_KEY with a verified sending domain)
# REQUIRE_PHONE_VERIFICATION=true   (needs Twilio Verify:)
# TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_VERIFY_SERVICE_SID=

# --- Unit economics in Admin (from your real provider pricing) ---
# AI_PRICE_INPUT_USD_PER_MTOK=  AI_PRICE_OUTPUT_USD_PER_MTOK=  AI_PRICE_WEB_SEARCH_USD_PER_1000=  USD_ZAR=
# AI_PRICE_CACHE_READ_USD_PER_MTOK=   (optional; defaults to the input price)
# Per-batch research budget; a batch stops early (keeping its results) once reached.
# BATCH_TOKEN_BUDGET=1500000   BATCH_BUDGET_USD=   (USD needs prices above)
# Monthly cap on what the server key may spend (customers' own keys excluded). Also set a limit in the Anthropic console.
# AI_MONTHLY_BUDGET_USD=   (fails closed if prices aren't set)   AI_MONTHLY_TOKEN_BUDGET=
