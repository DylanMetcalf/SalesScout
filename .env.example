# Sales Scout configuration. Copy to .env.local.

# Optional. Enables the AI layer (Company Brain analysis, market discovery,
# prospect discovery with live web research, outreach drafting).
# Without it, Sales Scout still works, and AI-dependent features show a clear
# "AI not connected" state instead of fake results.
ANTHROPIC_API_KEY=

# Optional: override the model used by the AI orchestrator.
# SALES_SCOUT_MODEL=claude-opus-5-5

# SQLite database location (default: ./data/salesscout.db)
# DATABASE_PATH=./data/salesscout.db
